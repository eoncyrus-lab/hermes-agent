# --- database roles ---------------------------------------------------------
#
# Six database identities, because the reach of each one is different and a
# single shared credential makes every bug a whole-database bug:
#
#   sonder_app      every ordinary request path. Scoped by a verified identity
#                   claim; NOBYPASSRLS.
#   sonder_identity bearer-token authentication only. No table privileges at
#                   all -- one RPC and nothing else. The API holds this.
#   sonder_bot      the same, for Telegram. Separate because a Telegram user
#                   id is guessable and a token digest is not, so whatever can
#                   call auth_telegram can walk the id space. Bot only.
#   sonder_erase    erasure and inspection. Reaches every relationship of ONE
#                   user, and no further. NOBYPASSRLS.
#   sonder_worker   the ingest/analysis pipeline. Scoped by the pinned
#                   relationship. NOBYPASSRLS.
#   sonder_maint    the only BYPASSRLS role. Scheduled cross-user jobs in the
#                   worker: outcome scoring and artifact purging. Never on a
#                   request path.
#
# docker-compose reads these to build the DSNs and to set the role passwords
# (scripts/db-roles.sh). Generate each with `openssl rand -base64 32`.
POSTGRES_PASSWORD=
SONDER_APP_DB_PASSWORD=
SONDER_IDENTITY_DB_PASSWORD=
SONDER_ERASURE_DB_PASSWORD=
SONDER_WORKER_DB_PASSWORD=
SONDER_MAINT_DB_PASSWORD=
SONDER_BOT_DB_PASSWORD=

# Set these directly only when running outside compose. There is intentionally
# no cross-dyad text-reader DSN: the shared app role cannot authenticate tenant
# ownership for such a capability.
# SONDER_DATABASE_URL=postgresql+asyncpg://sonder_app:...@db:5432/sonder
# SONDER_IDENTITY_DATABASE_URL=postgresql+asyncpg://sonder_identity:...@db:5432/sonder
# SONDER_ERASURE_DATABASE_URL=postgresql+asyncpg://sonder_erase:...@db:5432/sonder
# SONDER_WORKER_DATABASE_URL=postgresql+asyncpg://sonder_worker:...@db:5432/sonder
# SONDER_MAINTENANCE_DATABASE_URL=postgresql+asyncpg://sonder_maint:...@db:5432/sonder

SONDER_REDIS_URL=redis://redis:6379

# --- providers --------------------------------------------------------------
# Any subset. Two or more enables policy failover.
SONDER_ANTHROPIC_API_KEY=
# SONDER_ANTHROPIC_BASE_URL=

# Any OpenAI-compatible endpoint: Together, vLLM, Ollama, a local model.
# SONDER_OPENAI_API_KEY=
# SONDER_OPENAI_BASE_URL=

# --- third-party vendors ----------------------------------------------------
# One key each. All four are OpenAI-compatible Chat Completions endpoints, and
# all four are PERMISSIVE: their models' safety properties cannot be verified
# from here, so the router refuses to route EXTRACT or CRITIC to any of them.
# See "the safety guard" below.
#
# They also carry no default model. Vendor catalogues churn -- OpenRouter's
# `:free` variants and OpenCode Zen's free tier especially -- so a model that
# was free last month may not exist this month. Name the model explicitly in a
# route chain and the failure mode becomes a startup error, not a surprise
# invoice or a 404 in production.
# SONDER_MINIMAX_API_KEY=
# SONDER_MINIMAX_BASE_URL=https://api.minimax.io/v1
# SONDER_DEEPSEEK_API_KEY=
# SONDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# SONDER_OPENROUTER_API_KEY=
# SONDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SONDER_OPENROUTER_HTTP_REFERER=https://your.site   # attribution, optional
# SONDER_OPENROUTER_TITLE=Sonder                     # attribution, optional
# SONDER_ZEN_API_KEY=
# SONDER_ZEN_BASE_URL=https://opencode.ai/zen/v1

# --- ordered route chains ---------------------------------------------------
# JSON. Key is "<task>.<track>"; value is the failover order. The first hop
# this deployment has configured wins; a ContentPolicyRefusal moves to the
# next. Check it before deploying with:  sonder llm validate
#
# SONDER_LLM_ROUTES={"generate.standard":[{"provider":"deepseek","model":"deepseek-chat"},{"provider":"openrouter","model":"openrouter/free"}],"reason.standard":[{"provider":"anthropic","model":"claude-opus-5"}]}
#
# For a private gateway or a second account, declare the provider itself.
# `profile` supplies the endpoint and protocol defaults; declaring one never
# promotes it into a safety-trusted provider.
# SONDER_LLM_PROVIDERS={"openrouter-eu":{"profile":"openrouter","api_key":"...","base_url":"https://eu.example/api/v1"}}

# --- model routing by task. Call sites never name a model. ---
SONDER_MODEL_REASON=claude-opus-5
SONDER_MODEL_GENERATE=claude-opus-5
SONDER_MODEL_HUMANIZE=claude-opus-5
SONDER_MODEL_EXTRACT=claude-haiku-4-5-20251001
SONDER_MODEL_VISION=claude-opus-5

# --- vault key. In production this comes from a KMS, and never from the
# --- same account or provider that holds the database.
SONDER_VAULT_KEY=

SONDER_TELEGRAM_TOKEN=
SONDER_ARTIFACT_TTL_HOURS=24
SONDER_LOG_LEVEL=INFO

# --- self-hosted model for the intimate track ---
# A general-purpose hosted model hedges or declines on frank discussion of sex
# between adults, which makes it unusable for that part of the product. Point
# this at a model you host (vLLM / Ollama / llama.cpp).
# SONDER_LOCAL_BASE_URL=http://localhost:8000/v1
# SONDER_LOCAL_IS_PERMISSIVE=true  # deprecated; local is always safety-untrusted

# --- the safety guard -------------------------------------------------------
# Reasoning, generation and rewriting follow the track. Signal extraction and
# the Critic never do -- the router raises UnsafeRouting if you try, whether
# through a per-task provider, a declared route chain, or a failover hop.
#
# The reason is not squeamishness. Those two tasks exist to notice discomfort,
# boundaries and pressure. A model trained not to refuse is also trained not
# to notice, and the resulting failure is silent: boundary_risk comes back low
# for everything, the Critic passes candidates it should block, and nothing in
# the output looks wrong.
# SONDER_PROVIDER_GENERATE_INTIMATE=local
# SONDER_MODEL_GENERATE_INTIMATE=hermes-4-70b
# SONDER_PROVIDER_REASON_INTIMATE=local
# SONDER_MODEL_REASON_INTIMATE=hermes-4-70b
# SONDER_PROVIDER_EXTRACT=anthropic
